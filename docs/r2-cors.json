[
  {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://mdev-reader.netlify.app"
    ],
    "AllowedMethods": ["GET", "PUT", "HEAD"],
    "AllowedHeaders": ["content-type", "range"],
